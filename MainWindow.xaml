<Window x:Class="AirCard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Air Card" Width="1120" Height="820" MinWidth="940" MinHeight="720" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Style="{StaticResource {x:Type Window}}" Loaded="Window_Loaded" Closing="Window_Closing">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="12,0" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static ToolBar.ComboBoxStyleKey}}"><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="8,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="20" /></Style>
  </Window.Resources>
  <Border Style="{StaticResource DeveloperMainWindowFrameStyle}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="54" /><RowDefinition Height="*" /><RowDefinition Height="5" /><RowDefinition Height="150" MinHeight="80" /><RowDefinition Height="38" /></Grid.RowDefinitions>
      <DockPanel Style="{StaticResource DeveloperMainWindowCaptionStyle}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource DeveloperCaptionButtonStyle}" Width="44" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M 0,5 L 10,5" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
          <Button Style="{StaticResource DeveloperCaptionButtonStyle}" Width="44" Click="Maximize_Click" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化"><Path Data="M 0.5,0.5 L 9.5,0.5 9.5,9.5 0.5,9.5 Z" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
          <Button Style="{StaticResource DeveloperCaptionButtonStyle}" Width="44" Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭"><Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
        </StackPanel>
        <TextBlock Text="Air Card" FontWeight="SemiBold" Margin="14,0,16,0" VerticalAlignment="Center" />
      </DockPanel>
      <Border Grid.Row="1" BorderBrush="{DynamicResource EnvironmentToolWindowBorder}" BorderThickness="0,0,0,1" Padding="14,10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="132" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="设备" VerticalAlignment="Center" Margin="0,0,12,0" />
          <ComboBox x:Name="DeviceSelect" Grid.Column="1" Margin="0,0,10,0" SelectionChanged="Device_Changed" ToolTip="选择已配对的 iPhone" AutomationProperties.Name="设备" />
          <ComboBox x:Name="ModeSelect" Grid.Column="2" SelectedIndex="0" Margin="0,0,10,0" AutomationProperties.Name="连接方式"><ComboBoxItem Content="自动 · USB 优先" /><ComboBoxItem Content="仅 USB" /><ComboBoxItem Content="仅 WiFi" /></ComboBox>
          <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新设备" Style="{StaticResource ActionButton}" Margin="0" Click="Refresh_Click" />
        </Grid>
      </Border>
      <TabControl x:Name="Tabs" Grid.Row="2" Margin="6,8,6,0" Style="{StaticResource FileTabGroupTabControlStyle}" ItemContainerStyle="{StaticResource DeveloperWorkspaceTabItemStyle}">
        <TabItem Header="  钱包卡面  " Foreground="{DynamicResource EnvironmentForeground}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource EnvironmentToolWindow}">
            <Grid Margin="22,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="340" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" MinWidth="320" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="卡片标识" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="点击“扫描卡片”后，请在“钱包”App中点击要修改的卡片" Style="{StaticResource Hint}" Margin="0,0,0,12" />
                <DockPanel><Button x:Name="ScanButton" Content="扫描卡片" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Click="Scan_Click" Margin="10,0,0,0" /><TextBox x:Name="HashBox" Height="32" Padding="7,5" IsReadOnly="True" TextChanged="Hash_Changed" AutomationProperties.Name="卡片标识" ToolTip="扫描时请在 iPhone 钱包中打开目标卡片" /></DockPanel>
                <TextBlock x:Name="CardFormatInfo" Text="原始卡面格式：应用时识别" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                <Border Margin="0,18,0,18" Height="1" Background="{DynamicResource EnvironmentToolWindowBorder}" />
                <TextBlock Text="导出当前卡面" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="批量导出 Wallet 卡面缓存及可读取的原始资源，保留原始文件名。" Style="{StaticResource Hint}" Margin="0,0,0,10" />
                <TextBlock Text="先读取资源清单，再勾选导出内容；远程原图勾选后才联网下载。" Style="{StaticResource Hint}" Margin="0,0,0,10" />
                <Button x:Name="ExportButton" Content="导出全部卡面文件…" Style="{StaticResource ActionButton}" Click="Export_Click" HorizontalAlignment="Left" />
                <CheckBox x:Name="CaptureExportLog" Content="采集导出诊断日志" Foreground="{DynamicResource EnvironmentForeground}" Margin="0,12,0,0" ToolTip="导出期间读取手机同步日志，单独保存到所选文件夹；日志可能包含设备或文件标识。" />
                <TextBlock Text="实验性读取：临时移出图片并放回。完成前请保持手机连接。" Style="{StaticResource Hint}" FontSize="11" Margin="0,9,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="替换卡面" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="点击“应用到所选卡片”后识别格式，不匹配时可转换或取消。" Style="{StaticResource Hint}" Margin="0,0,0,12" />
                <Border Background="#202023" BorderBrush="{DynamicResource EnvironmentToolWindowBorder}" BorderThickness="1" CornerRadius="12" Height="232" Padding="8">
                  <Grid><Image x:Name="SkinPreview" Stretch="Uniform" /><StackPanel x:Name="EmptyPreview" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="选择卡面图片或单页 PDF" FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,8" /><TextBlock Text="PNG / JPG / WebP / PDF" Style="{StaticResource Hint}" HorizontalAlignment="Center" /></StackPanel></Grid>
                </Border>
                <TextBlock x:Name="SkinInfo" Text="尚未选择卡面" Style="{StaticResource Hint}" Margin="0,9,0,12" TextTrimming="CharacterEllipsis" />
                <WrapPanel Margin="0,0,0,10"><Button x:Name="ChooseSkinButton" Content="选择卡面…" Style="{StaticResource ActionButton}" Click="ChooseSkin_Click" /><Button x:Name="SaveSkinButton" Content="保存处理后的 PNG…" Style="{StaticResource ActionButton}" Click="SaveSkin_Click" /><Button x:Name="SubmitCardButton" Content="投稿卡面…" Style="{StaticResource ActionButton}" Click="SubmitCard_Click" Margin="0" ToolTip="打开 GitHub 投稿表单，上传卡面供审核收录。" /></WrapPanel>
                <Button x:Name="ApplySkinButton" Content="应用到所选卡片" Style="{StaticResource ActionButton}" Click="ApplySkin_Click" Margin="0" HorizontalAlignment="Stretch" />
                <TextBlock Text="应用后退出并重新打开钱包，查看新卡面。" Style="{StaticResource Hint}" FontSize="11" Margin="0,9,0,0" />
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="  使用说明  " Foreground="{DynamicResource EnvironmentForeground}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource EnvironmentToolWindow}"><StackPanel Margin="28,24" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Text="连接与使用" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Hint}" Text="1. 安装 Apple 官方完整 64 位桌面版 iTunes（包含设备驱动和同步组件）。&#10;2. USB 连接 iPhone，解锁并信任此电脑，然后刷新设备。&#10;3. 扫描卡片时，在手机钱包里点开目标卡片；识别到第一张后自动停止。&#10;4. 选择导出当前卡面，或导入图片、单页 PDF；点击应用后识别格式，不匹配时选择转换或取消。&#10;5. WiFi 连接需要先通过 USB 配对并启用 WiFi 同步。" />
            <TextBlock Text="卡面导出" Style="{StaticResource SectionTitle}" Margin="0,24,0,8" />
            <TextBlock Style="{StaticResource Hint}" Text="选择一个文件夹，程序会在其中创建 AirCard_output_卡片Hash 子目录，批量导出可读取的文件。&#10;&#10;导出列表分为本地文件和在线文件。从卡片目录及资源清单发现实际图片，保留原始文件名；不显示或导出 .urls 索引。清单可能不包含后续添加的文件。在线文件默认不选，勾选后从 Apple 下载并校验大小及 SHA-1；同名项同时勾选时保存在线原图。本地文件未读到时不会自动联网补取。Wallet 卡面缓存另存为“Wallet 卡面缓存.png”或“.jpg”，可能包含圆角及已合成的文字。&#10;&#10;没有读取到的资源会跳过，完成后显示导出数量。重复导出会更新成功读取的同名文件；未读取到的旧文件和其他文件保留。&#10;&#10;导出过程中请保持手机连接，等操作完成再拔线。" />
            <TextBlock Text="关于此版本" Style="{StaticResource SectionTitle}" Margin="0,24,0,8" />
            <TextBlock Style="{StaticResource Hint}" Text="Air Card 1.3 · C# · .NET Framework 4.7.2 · WPF · Windows x64&#10;设备引擎移植自 Lumid-Off/AirCard-Windows 与 0xjohnnydev/airlift。&#10;源代码与第三方授权见随附 README 和 ThirdParty 目录。" />
            <TextBlock x:Name="DriverInfo" Style="{StaticResource Hint}" Margin="0,18,0,0" />
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
      <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource EnvironmentToolWindowBorder}" />
      <Border Grid.Row="4" Margin="6,0" BorderBrush="{DynamicResource EnvironmentToolWindowBorder}" BorderThickness="1">
        <DockPanel><Border DockPanel.Dock="Top" Background="{DynamicResource EnvironmentToolWindow}" Padding="10,4"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="保存日志…" Style="{StaticResource ActionButton}" Padding="8,0" Click="SaveLog_Click" Margin="0,0,8,0" /><Button Content="清空" Style="{StaticResource ActionButton}" Padding="8,0" Margin="0" Click="ClearLog_Click" /></StackPanel><TextBlock Text="操作日志" VerticalAlignment="Center" /></DockPanel></Border>
          <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" BorderThickness="0" Padding="8,4" AutomationProperties.Name="操作日志" />
        </DockPanel>
      </Border>
      <Grid Grid.Row="5" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button x:Name="CancelOperationButton" Grid.Column="1" Content="取消操作" Height="32" Padding="10,0" Margin="10,0,14,0" Click="CancelOperation_Click" ToolTip="停止后续资源读写；当前同步和原文件归位完成后退出。" />
        <ProgressBar x:Name="Progress" Grid.Column="2" Height="3" VerticalAlignment="Center" Visibility="Collapsed" IsIndeterminate="True" />
      </Grid>
    </Grid>
  </Border>
</Window>
